# koro-backend — YEREL GELİŞTİRME örneği. Gerçek secret koymayın: `cp .env.example .env`
# Prod/staging'de secret'lar *_FILE ile Docker secret dosyasından verilir (ör. PASSWORD_PEPPER_FILE=/run/secrets/password_pepper).
# Her bölüm tek bir pakete/modüle aittir (BE-001 R7): yalnız kendi bölümünüzü düzenleyin, bölümler arasında boş satır kalsın.
# Değişkenin tipi, varsayılanı ve doğrulaması internal/platform/config/<bölüm>.go dosyasındadır.

# --- common ---
APP_ENV=dev
LOG_LEVEL=INFO
LOG_FORMAT=text

# --- httpx ---
HTTP_ADDR=:8080
PUBLIC_BASE_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000
TRUSTED_PROXIES=
REQUEST_TIMEOUT=15s
SHUTDOWN_DELAY=5s
SHUTDOWN_TIMEOUT=25s
EXPOSE_OPENAPI=true
# PROBLEM_TYPE_BASE=urn:koro:problem:

# --- obs ---
# Boş = kapalı (ek yük yok). OTLP/HTTP collector taban adresi (izler <taban>/v1/traces'e gider), ör. http://otel-collector:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
# Kök izlerin örnekleme oranı (ParentBased); 0 < oran <= 1.
OTEL_TRACES_SAMPLER_ARG=0.1
# Prometheus GET /metrics için AYRI iç dinleyici (public router'da yok; Traefik'e yayınlanmaz), ör. 127.0.0.1:9090
# veya konteyner iç ağı için :9090. api ve worker aynı değişkeni kullanır.
METRICS_ADDR=

# --- db ---
# Uygulama rolü app_rw (api + worker). Yerel parola deploy/db/dev-passwords.sql'deki ile aynı; prod'da DATABASE_URL_FILE.
DATABASE_URL=postgres://app_rw:dev-only-change-me@localhost:5432/koro?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_STATEMENT_TIMEOUT=15s
DB_IDLE_IN_TX_TIMEOUT=30s

# --- migratekit ---
# Yalnız `koro migrate`: tablo sahibi app_owner, doğrudan PostgreSQL'e (PgBouncer arkasından değil: advisory lock).
MIGRATE_DATABASE_URL=postgres://app_owner:dev-only-change-me@localhost:5432/koro?sslmode=disable

# --- queue ---
# Redis (asynq, rate limit). AOF + noeviction zorunlu (deploy/compose.dev.yaml). Parola varsa prod'da REDIS_URL_FILE.
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=30
WORKER_CONCURRENCY=10
# Birden çok worker replikasında da güvenli (her iş Unique); istenirse yalnız birinde true.
WORKER_SCHEDULER_ENABLED=true
WORKER_SHUTDOWN_TIMEOUT=25s
# Worker canlılık/hazırlık uçları (/healthz, /readyz); boş = kapalı. Docker HEALTHCHECK:
# koro healthcheck -url http://127.0.0.1:8081/healthz
WORKER_HEALTH_ADDR=127.0.0.1:8081

# --- outbox ---
OUTBOX_RELAY_BATCH=100
OUTBOX_RELAY_IDLE=1s
OUTBOX_RELAY_BACKOFF_MAX=10m
# Yayımlanan satırların saklama süresi (kvkk retention_policies 'outbox_published' gelene kadar).
OUTBOX_RETENTION=168h

# --- idempotency ---
IDEMPOTENCY_TTL=24h

# --- inbox ---
# Webhook ham yükü 90 gün, satır 2 yıl (kvkk retention_policies gelene kadar).
WEBHOOK_PAYLOAD_RETENTION=2160h
WEBHOOK_ROW_RETENTION=17520h

# --- ratelimit ---
# Yalnız dev'de kapatılabilir (staging/prod'da reddedilir).
RATE_LIMIT_ENABLED=true

# --- storage ---
# S3 uyumlu nesne deposu (yerelde deploy/compose.dev.yaml SeaweedFS; anahtarlar deploy/seaweedfs/s3.dev.json).
# Bucket'lar özel (public erişim yok); karantina bucket'ına 1 günlük yaşam döngüsü kuralı sağlayıcıda verilir.
# staging/prod: https uç nokta + S3_ACCESS_KEY_FILE / S3_SECRET_KEY_FILE (Docker secret); dev değerleri reddedilir.
S3_ENDPOINT=http://127.0.0.1:8333
# Tarayıcının erişeceği adres (presigned URL bu host için imzalanır); boş = S3_ENDPOINT.
S3_PRESIGN_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=koro-dev-access-key
S3_SECRET_KEY=dev-only-change-me
S3_PATH_STYLE=true
S3_TIMEOUT=30s
S3_BUCKET_FILES=koro-files-dev
S3_BUCKET_QUARANTINE=koro-quarantine-dev

# --- crypto ---
# Yerel KEK (OpenBao BE-055'e kadar). Biçim: kimlik:base64[,kimlik:base64]; ilki etkin, diğerleri yalnız çözer.
# Aşağıdakiler YALNIZ GELİŞTİRME yer tutucusudur (staging/prod'da reddedilir). Üretmek: openssl rand -base64 32
# Prod/staging: CRYPTO_KEKS_FILE=/run/secrets/crypto_keks (diğerleri de *_FILE ile).
CRYPTO_KEKS=dev1:ZGV2ZGV2ZGV2ZGV2ZGV2ZGV2ZGV2ZGV2ZGV2ZGV2ZGU=
CRYPTO_BLIND_INDEX_KEY=aWR4aWR4aWR4aWR4aWR4aWR4aWR4aWR4aWR4aWR4aWQ=
CRYPTO_TOKEN_KEYS=dev1:dG9rdG9rdG9rdG9rdG9rdG9rdG9rdG9rdG9rdG9rdG8=

# --- passwd ---
# YALNIZ GELİŞTİRME yer tutucusu (≥ 32 bayt; staging/prod'da reddedilir). Prod: PASSWORD_PEPPER_FILE=/run/secrets/password_pepper
PASSWORD_PEPPER=devpepperdevpepperdevpepperdevpepper
PASSWORD_HASH_CONCURRENCY=4

# --- realtime ---

# --- audit ---
# Günlük kök imza anahtarları (Ed25519 tohumu, 32 bayt): kimlik:base64[,kimlik:base64]; ilki imzalar, diğerleri
# yalnız doğrular. Aşağıdaki YALNIZ GELİŞTİRME yer tutucusudur (staging/prod'da reddedilir; orada zorunlu).
# Prod: AUDIT_ROOT_SIGNING_KEYS_FILE=/run/secrets/audit_root_keys. Üretmek: openssl rand -base64 32
AUDIT_ROOT_SIGNING_KEYS=dev1:YXVkaXRhdWRpdGF1ZGl0YXVkaXRhdWRpdGF1ZGl0YXU=
# İmzalı kök kopyalarının yazıldığı ayrı, bir kez yazılır dizin (mutlak yol; staging/prod'da zorunlu, ayrı volume).
AUDIT_ROOT_ARCHIVE_DIR=/tmp/koro-audit-roots

# --- files ---
# true: indirme yalnız scan_status=clean (ClamAV, BE-048). false (yalnız dev): "skipped" da indirilebilir.
# true için gerçek tarayıcı şart; no-op tarayıcıyla süreç açılmaz. staging/prod: true + FILES_SCANNER=clamav zorunlu.
FILES_SCAN_REQUIRED=false
# Presigned yükleme URL'si ömrü (04 §1.14: 10 dk; en çok 10m).
FILES_UPLOAD_URL_TTL=10m
# Tarayıcı: noop (her dosya "skipped") | clamav (clamd TCP INSTREAM). Yerelde clamav için:
# docker compose -f deploy/compose.dev.yaml up -d --wait clamav (profil "clamav"; make deps-up başlatmaz; ~1–1,5 GB bellek).
# Durdurmak: docker compose -f deploy/compose.dev.yaml --profile clamav down
FILES_SCANNER=noop
# clamd TCPSocket (host:port).
FILES_CLAMAV_ADDR=127.0.0.1:3310
# Tek taramanın üst süresi (bağlantı + akış + karar). Aşılırsa dosya pending kalır, sonra yeniden taranır.
FILES_CLAMAV_TIMEOUT=60s
# Bağlantı havuzu: süreç başına en çok eşzamanlı tarama / açık clamd oturumu.
FILES_CLAMAV_MAX_CONNS=4
# clamd'ye gönderilecek en büyük nesne (bayt); clamd StreamMaxLength ile aynı olmalı (25M = 26214400).
FILES_CLAMAV_MAX_BYTES=26214400
# true: /readyz clamd'ye PING atar (isteğe bağlı; kapalıyken clamd kesintisi yalnız taramayı geciktirir).
FILES_CLAMAV_READY_CHECK=false
# files.rescan_skipped: gerçek tarayıcı bağlıyken her çalışmada yeniden taranan "skipped" dosya sayısı (1–1000).
FILES_RESCAN_BATCH=100

# --- consent ---
# true: gerçek İYS istemcisi olmadan süreç açılmaz (canlı, H-14; adaptör BE-055).
# false (dev): ticari rızaların İYS gönderimi "skipped" olarak kapanır.
CONSENT_IYS_REQUIRED=false

# --- entitlements ---

# --- notify ---
# Dev: Mailpit (SMTP 1025, UI http://localhost:8025). staging/prod: a real relay, SMTP_TLS=starttls|tls,
# a real SMTP_FROM domain; the password comes from SMTP_PASSWORD_FILE (Docker secret).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS=none
SMTP_FROM=noreply@koro.test
SMTP_FROM_NAME=Koro
SMTP_TIMEOUT=15s
# SMTP_USERNAME=
# SMTP_PASSWORD=
# Bounce/complaint webhooks (POST /api/v1/webhooks/email/{ses|resend}); unset = that provider answers 401.
# Resend: the svix signing secret (EMAIL_WEBHOOK_RESEND_SECRET_FILE in staging/prod).
# EMAIL_WEBHOOK_RESEND_SECRET=whsec_...
# SES: the SNS topics allowed to post (comma separated). The topic must use SignatureVersion 2 (SHA256);
# confirm the HTTPS subscription in the AWS console (Koro never follows SubscribeURL).
# EMAIL_WEBHOOK_SES_TOPIC_ARNS=arn:aws:sns:eu-central-1:123456789012:koro-ses-events

# --- identity ---
# Web uygulamasının kökü: doğrulama, parola sıfırlama ve e-posta değişikliği bağlantıları buraya gider
# (token URL parçasında, #token=...). staging/prod: https ve localhost değil (api + worker).
IDENTITY_LINK_BASE_URL=http://localhost:3000

