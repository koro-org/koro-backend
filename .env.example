# koro-backend — YEREL GELİŞTİRME örneği. Gerçek secret koymayın: `cp .env.example .env`
# Prod/staging'de secret'lar *_FILE ile Docker secret dosyasından verilir (ör. PASSWORD_PEPPER_FILE=/run/secrets/password_pepper).
# Her bölüm tek bir pakete/modüle aittir (BE-001 R7): yalnız kendi bölümünüzü düzenleyin, bölümler arasında boş satır kalsın.
# Değişkenin tipi, varsayılanı ve doğrulaması internal/platform/config/<bölüm>.go dosyasındadır.

# --- common ---
APP_ENV=dev
LOG_LEVEL=INFO
LOG_FORMAT=text

# --- httpx ---
HTTP_ADDR=:8080
PUBLIC_BASE_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000
TRUSTED_PROXIES=
REQUEST_TIMEOUT=15s
SHUTDOWN_DELAY=5s
SHUTDOWN_TIMEOUT=25s
EXPOSE_OPENAPI=true
# PROBLEM_TYPE_BASE=urn:koro:problem:

# --- obs ---
# Boş = kapalı (ek yük yok). OTLP/HTTP collector taban adresi (izler <taban>/v1/traces'e gider), ör. http://otel-collector:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
# Kök izlerin örnekleme oranı (ParentBased); 0 < oran <= 1.
OTEL_TRACES_SAMPLER_ARG=0.1
# Prometheus GET /metrics için AYRI iç dinleyici (public router'da yok; Traefik'e yayınlanmaz), ör. 127.0.0.1:9090
# veya konteyner iç ağı için :9090. api ve worker aynı değişkeni kullanır.
METRICS_ADDR=

# --- db ---
# Uygulama rolü app_rw (api + worker). Yerel parola deploy/db/dev-passwords.sql'deki ile aynı; prod'da DATABASE_URL_FILE.
DATABASE_URL=postgres://app_rw:dev-only-change-me@localhost:5432/koro?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_STATEMENT_TIMEOUT=15s
DB_IDLE_IN_TX_TIMEOUT=30s

# --- migratekit ---
# Yalnız `koro migrate`: tablo sahibi app_owner, doğrudan PostgreSQL'e (PgBouncer arkasından değil: advisory lock).
MIGRATE_DATABASE_URL=postgres://app_owner:dev-only-change-me@localhost:5432/koro?sslmode=disable

# --- queue ---
# Redis (asynq, rate limit). AOF + noeviction zorunlu (deploy/compose.dev.yaml). Parola varsa prod'da REDIS_URL_FILE.
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=30
WORKER_CONCURRENCY=10
# Birden çok worker replikasında da güvenli (her iş Unique); istenirse yalnız birinde true.
WORKER_SCHEDULER_ENABLED=true
WORKER_SHUTDOWN_TIMEOUT=25s
# Worker canlılık/hazırlık uçları (/healthz, /readyz); boş = kapalı. Docker HEALTHCHECK:
# koro healthcheck -url http://127.0.0.1:8081/healthz
WORKER_HEALTH_ADDR=127.0.0.1:8081

# --- outbox ---
OUTBOX_RELAY_BATCH=100
OUTBOX_RELAY_IDLE=1s
OUTBOX_RELAY_BACKOFF_MAX=10m
# Yayımlanan satırların saklama süresi (kvkk retention_policies 'outbox_published' gelene kadar).
OUTBOX_RETENTION=168h

# --- idempotency ---
IDEMPOTENCY_TTL=24h

# --- inbox ---
# Webhook ham yükü 90 gün, satır 2 yıl (kvkk retention_policies gelene kadar).
WEBHOOK_PAYLOAD_RETENTION=2160h
WEBHOOK_ROW_RETENTION=17520h

# --- ratelimit ---
# Yalnız dev'de kapatılabilir (staging/prod'da reddedilir).
RATE_LIMIT_ENABLED=true
# koro-web kovası (BE-119; yalnız `koro api` okur): koro-web'in cookie'siz önbellekli okumaları (publicFetch)
# X-Koro-Web-Key başlığıyla gelir ve tek IP yerine ayrı web_internal kovasında (3000/dk) sayılır. Yalnız
# oran sınırı kovasını seçer; kimlik/yetki vermez. Başlık yalnız GET/HEAD, Cookie/Authorization ve
# X-Forwarded-For/X-Real-IP/Forwarded YOKKEN geçerlidir (Traefik'ten gelen istekte hep XFF var).
# Virgüllü en çok 2 anahtar (etkin + döndürmede eski), her biri 32–256 karakter [A-Za-z0-9._~+/=-];
# koro-web'deki KORO_API_WEB_KEY bunlardan biri olmalı. İsteğe bağlı: boşsa web normal IP kovasında
# (staging/prod'da uyarı). KORO_REVALIDATE_SECRET'tan ayrı bir değer (üret: openssl rand -hex 32).
# Prod: RATE_LIMIT_WEB_KEYS_FILE=/run/secrets/api_web_key (o zaman RATE_LIMIT_WEB_KEYS hiç yazılmaz).
# RATE_LIMIT_WEB_KEYS=

# --- storage ---
# S3 uyumlu nesne deposu (yerelde deploy/compose.dev.yaml SeaweedFS; anahtarlar deploy/seaweedfs/s3.dev.json).
# Bucket'lar özel (public erişim yok); karantina bucket'ına 1 günlük yaşam döngüsü kuralı sağlayıcıda verilir.
# staging/prod: https uç nokta + S3_ACCESS_KEY_FILE / S3_SECRET_KEY_FILE (Docker secret); dev değerleri reddedilir.
# Adaptör (BE-113): s3 (S3 uyumlu sunucu) | mem (bellek içi, yalnız dev; staging/prod'da süreç açılmaz).
# S3_ENDPOINT/REGION/anahtarlar/TIMEOUT yalnız s3'te denetlenir; S3_BUCKET_* her adaptörde kullanılır.
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://127.0.0.1:8333
# Tarayıcının erişeceği adres (presigned URL bu host için imzalanır); boş = S3_ENDPOINT.
S3_PRESIGN_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=koro-dev-access-key
S3_SECRET_KEY=dev-only-change-me
S3_PATH_STYLE=true
S3_TIMEOUT=30s
S3_BUCKET_FILES=koro-files-dev
S3_BUCKET_QUARANTINE=koro-quarantine-dev

# --- crypto ---
# Yerel KEK. Biçim: kimlik:base64[,kimlik:base64]; ilki etkin, diğerleri yalnız çözer. Kimlik "bao." ile başlayamaz.
# Aşağıdakiler YALNIZ GELİŞTİRME yer tutucusudur (staging/prod'da reddedilir). Üretmek: openssl rand -base64 32
# Prod/staging: CRYPTO_KEKS_FILE=/run/secrets/crypto_keks (diğerleri de *_FILE ile).
CRYPTO_KEKS=dev1:ZGV2ZGV2ZGV2ZGV2ZGV2ZGV2ZGV2ZGV2ZGV2ZGV2ZGU=
CRYPTO_BLIND_INDEX_KEY=aWR4aWR4aWR4aWR4aWR4aWR4aWR4aWR4aWR4aWR4aWQ=
CRYPTO_TOKEN_KEYS=dev1:dG9rdG9rdG9rdG9rdG9rdG9rdG9rdG9rdG9rdG9rdG8=
# OpenBao Transit (BE-055; KVKK: anahtar veriden ayrı ortamda). Adres verilince yeni değerler OpenBao'da sarılır;
# CRYPTO_KEKS o zaman yalnız eski değerleri açar (crypto.rewrap taşıyınca kaldırılabilir). OpenBao erişilemezse
# şifreleme yapılmaz (fail-closed) ve /readyz "openbao" kırmızıdır. Prod'da zorunlu; bilinçli devre dışı:
# CRYPTO_OPENBAO_REQUIRED=false. Prod: https adres, CRYPTO_OPENBAO_TOKEN_FILE (Transit politikalı periyodik token),
# gerekirse CRYPTO_OPENBAO_CA_CERT_FILE. Geliştirme: compose profili "openbao" (dev modu; make deps-up başlatmaz):
# docker compose -f deploy/compose.dev.yaml up -d --wait openbao openbao-init — sonra satırları açın:
# CRYPTO_OPENBAO_ADDR=http://127.0.0.1:8200
# CRYPTO_OPENBAO_TOKEN=dev-only-openbao-root
# CRYPTO_OPENBAO_TRANSIT_MOUNT=transit
# CRYPTO_OPENBAO_KEY=koro-kek
# CRYPTO_OPENBAO_TIMEOUT=5s
# CRYPTO_OPENBAO_REQUIRED=

# --- passwd ---
# YALNIZ GELİŞTİRME yer tutucusu (≥ 32 bayt; staging/prod'da reddedilir). Prod: PASSWORD_PEPPER_FILE=/run/secrets/password_pepper
PASSWORD_PEPPER=devpepperdevpepperdevpepperdevpepper
PASSWORD_HASH_CONCURRENCY=4

# --- realtime ---
# Yeni değişken yok: WebSocket el sıkışmasının Origin denetimi TRUSTED_ORIGINS'i (yukarıda) kullanır; pub/sub REDIS_URL'dedir.
# Sınırlar 04 §W'de sabit: etkinlik başına 50, kullanıcı başına 3 bağlantı, 60 sn'de bir yeniden yetki.

# --- webcache ---
# Yayın webhook'u (BE-106; yalnız `koro worker` okur): public kulüp/şirket/etkinlik değişince worker imzalı
# POST {KORO_WEB_INTERNAL_URL}/api/revalidate gönderir (sözleşme: koro-web src/lib/revalidate.ts).
# staging/prod'da ikisi de zorunlu; geliştirmede boşsa webhook atlanır (uyarı). Sır koro-web'deki
# KORO_REVALIDATE_SECRET ile aynı, en az 32 karakter (üret: openssl rand -hex 32).
# Prod: KORO_REVALIDATE_SECRET_FILE=/run/secrets/koro_revalidate_secret (o zaman KORO_REVALIDATE_SECRET hiç yazılmaz).
# KORO_WEB_INTERNAL_URL=http://localhost:3000
# KORO_REVALIDATE_SECRET=

# --- audit ---
# Günlük kök doğrulama anahtarları (Ed25519 AÇIK anahtar, 32 bayt; sır değil): kimlik:base64[,kimlik:base64].
# api (POST /admin/audit/verify) ve worker (audit.verify_chain) okur; staging/prod'da zorunlu. Her imza
# anahtarının (eskiler dahil) aynı kimlikle açık anahtarı burada olmalı, yoksa worker açılmaz. Tohumdan üretmek:
#   (printf '302e020100300506032b657004220420' | xxd -r -p; echo <tohum-base64> | base64 -d) | openssl pkey -inform DER -pubout -outform DER | tail -c 32 | base64
# Aşağıdaki, alttaki geliştirme tohumunun açık anahtarıdır.
AUDIT_ROOT_VERIFY_KEYS=dev1:eARyIQn7PbU7ZruoCTHgf7ojtVhotKNa+pBr0/m6gEI=
# YALNIZ WORKER (BE-107, en az yetki): api bu iki değişkeni okumaz; staging/prod'da api konteynerine verilirse uyarı loglar.
# Günlük kök imza anahtarları (Ed25519 tohumu, 32 bayt): kimlik:base64[,kimlik:base64]; ilki imzalar, diğerleri
# yalnız doğrular. Aşağıdaki YALNIZ GELİŞTİRME yer tutucusudur (staging/prod'da reddedilir; orada zorunlu).
# Prod: AUDIT_ROOT_SIGNING_KEYS_FILE=/run/secrets/audit_root_keys. Üretmek: openssl rand -base64 32
AUDIT_ROOT_SIGNING_KEYS=dev1:YXVkaXRhdWRpdGF1ZGl0YXVkaXRhdWRpdGF1ZGl0YXU=
# İmzalı kök kopyalarının yazıldığı ayrı, bir kez yazılır dizin (mutlak yol; staging/prod'da zorunlu, ayrı volume).
AUDIT_ROOT_ARCHIVE_DIR=/tmp/koro-audit-roots

# --- files ---
# true: indirme yalnız scan_status=clean (ClamAV, BE-048). false (yalnız dev): "skipped" da indirilebilir.
# true için gerçek tarayıcı şart; no-op tarayıcıyla süreç açılmaz. staging/prod: true + FILES_SCANNER=clamav zorunlu.
FILES_SCAN_REQUIRED=false
# Presigned yükleme URL'si ömrü (04 §1.14: 10 dk; en çok 10m).
FILES_UPLOAD_URL_TTL=10m
# Tarayıcı adaptörü (BE-113 kalıbı; anahtar adı eski): noop (her dosya "skipped"; yalnız dev, staging/prod'da süreç
# açılmaz) | clamav (clamd TCP INSTREAM). Yerelde clamav için:
# docker compose -f deploy/compose.dev.yaml up -d --wait clamav (profil "clamav"; make deps-up başlatmaz; ~1–1,5 GB bellek).
# Durdurmak: docker compose -f deploy/compose.dev.yaml --profile clamav down
FILES_SCANNER=noop
# clamd TCPSocket (host:port).
FILES_CLAMAV_ADDR=127.0.0.1:3310
# Tek taramanın üst süresi (bağlantı + akış + karar). Aşılırsa dosya pending kalır, sonra yeniden taranır.
FILES_CLAMAV_TIMEOUT=60s
# Bağlantı havuzu: süreç başına en çok eşzamanlı tarama / açık clamd oturumu.
FILES_CLAMAV_MAX_CONNS=4
# clamd'ye gönderilecek en büyük nesne (bayt); clamd StreamMaxLength ile aynı olmalı (25M = 26214400).
FILES_CLAMAV_MAX_BYTES=26214400
# true: /readyz clamd'ye PING atar (isteğe bağlı; kapalıyken clamd kesintisi yalnız taramayı geciktirir).
FILES_CLAMAV_READY_CHECK=false
# files.rescan_skipped: gerçek tarayıcı bağlıyken her çalışmada yeniden taranan "skipped" dosya sayısı (1–1000).
FILES_RESCAN_BATCH=100

# --- consent ---
# true: gerçek İYS istemcisi olmadan süreç açılmaz (canlı, H-14).
# false: İYS adaptörü yokken (none) ticari rıza (requires_iys) TOPLANMAZ (409 consent.iys_unavailable; kayıt sayfasındaki
# ticari onay atlanır, hesap açılır); geri çekmelerin İYS gönderimi "skipped" kapanır.
CONSENT_IYS_REQUIRED=false
# İYS adaptörü (BE-105; internal/platform/iys), tek seçim noktası cmd/koro/wire_consent.go iysAdapters (adapters[T], BE-114):
#   none     (varsayılan) adaptör yok: ticari rıza toplanmaz. İYS bağlantısı canlı olana dek staging/prod değeri.
#   fake     bellek içi İYS (yalnız dev; staging/prod'da süreç açılmaz). Bu dosya dev içindir: fake.
#   official İYS'nin kendi API'si; canlıda YALNIZ doğrudan API erişimi (İLETİ+) varsa. 250 bin adres altı hizmet sağlayıcı
#            İYS'ye yetkili entegratör üzerinden bağlanır. Test: https://api.sandbox.iys.org.tr (kayıtlı çıkış IP'si gerekir).
#   netgsm   pilot entegratörü (BE-110; İLETİ-5 + Netgsm): aşağıdaki CONSENT_IYS_NETGSM_* ayarlarıyla.
# Neden kapı: İYS dışında alınan ticari ileti onayı 3 iş günü içinde İYS'ye yüklenmezse geçersizdir (Yönetmelik m.7/11–12).
CONSENT_IYS_PROVIDER=fake
# İYS'nin kendi API'si (BE-055; CONSENT_IYS_PROVIDER=official): hepsi birlikte verilir. Prod: https, CONSENT_IYS_PASSWORD_FILE.
# CONSENT_IYS_BASE_URL=https://api.iys.org.tr
# CONSENT_IYS_USERNAME=
# CONSENT_IYS_PASSWORD=
# CONSENT_IYS_CODE=
# CONSENT_IYS_BRAND_CODE=
# CONSENT_IYS_RECIPIENT_TYPE=BIREYSEL
# CONSENT_IYS_TIMEOUT=10s
# Netgsm İYS (BE-110; CONSENT_IYS_PROVIDER=netgsm): kullanıcı adı, parola, İYS kodu, marka kodu ve webhook gizlisi birlikte
# verilir; CONSENT_IYS_RECIPIENT_TYPE ve CONSENT_IYS_TIMEOUT burada da geçerli. Prod: https, *_PASSWORD_FILE ve
# *_WEBHOOK_TOKEN_FILE (Docker secret). Yükleme asenkron: İYS'nin cevabı (başarı/Hxxx) ve İYS'de verilen ret/onaylar
# webhook ile gelir. Netgsm portalındaki webhook URL'si: https://<api>/api/v1/webhooks/iys/netgsm/<CONSENT_IYS_NETGSM_WEBHOOK_TOKEN>
# (Netgsm imza göndermiyor: URL'deki gizli kanıttır; en az 32 karakter [A-Za-z0-9_-], ör. `openssl rand -hex 32`).
# CONSENT_IYS_NETGSM_BASE_URL=https://api.netgsm.com.tr
# CONSENT_IYS_NETGSM_USERNAME=
# CONSENT_IYS_NETGSM_PASSWORD=
# CONSENT_IYS_NETGSM_IYS_CODE=
# CONSENT_IYS_NETGSM_BRAND_CODE=
# CONSENT_IYS_NETGSM_WEBHOOK_TOKEN=
# Webhook yalnız bu adreslerden kabul edilir (IP/CIDR, virgülle). Prod'da zorunlu (Q-16; boşsa ya da /0 ise süreç açılmaz);
# dev/staging'de boş = her adres. İstemci adresi TRUSTED_PROXIES ile çözülür. İYS'nin "kayıt başarılı" cevabı ayrıca
# /iys/search ile İYS kaydından doğrulanmadan gönderim "sent" sayılmaz (BE-114).
# CONSENT_IYS_NETGSM_WEBHOOK_ALLOWED_IPS=
# Koro referansının (refid) yeri: header (Netgsm parametre tablosu) | item (Netgsm PHP paketi). Netgsm'le doğrulanacak (00 T-368).
# CONSENT_IYS_NETGSM_REFID_IN=header
# Bütçeler (worker başına; Netgsm: dakikada en fazla 10 istek): tüm çağrılar, saatlik tekil sorgu, yedek kontrolün saatlik
# sorgusu (consent.iys_netgsm_recheck, 10 dakikada bir, sorgular aralıklı: webhook'u kaçırılmış İYS retleri; 0 = kapalı).
# CONSENT_IYS_NETGSM_REQUESTS_PER_MINUTE=8
# CONSENT_IYS_NETGSM_STATUS_QUERIES_PER_HOUR=240
# CONSENT_IYS_NETGSM_RECHECK_PER_HOUR=120
# Bir gönderim denemesinin İYS cevabını webhook'tan bekleme süresi; cevapsız yüklemenin yeniden gönderilme süresi.
# CONSENT_IYS_NETGSM_RESULT_WAIT=15s
# CONSENT_IYS_NETGSM_RESEND_AFTER=1h
# İYS'de verilen retlerin mutabakatı (BE-103, BE-105): consent.iys_status_sync saatte bir adaptörün değişiklik akışını
# (İYS'nin PULL listesi ya da entegratörün ilettikleri) okur ve İYS'de RET olan alıcılar için defterde geri çekme
# (kanal iys) yazar. >0 ise kanalın son tam mutabakatı bu süreden eskiyse (ya da hiç yapılmadıysa) ticari e-posta
# gönderimi bekletilir (0 = kapalı; 3h–168h: İYS listesi son bir saati göstermez). Gerekçe: 6563'te ticari ileti
# İYS'deki güncel duruma göre gönderilir. İYS'yi okuyan bir adaptör gerekir.
CONSENT_IYS_SYNC_MAX_AGE=0s
# Ticari e-postanın tek tık abonelikten çıkma bağlantısının tabanı (BE-062; 6563 ret, RFC 8058: altbilgi ve
# List-Unsubscribe). Bağlantı <taban>/<imzalı token>: API ucu (https://<api>/api/v1/unsubscribe-links) ya da GET'i
# sayfa olarak gösteren ve POST'u bu uca ileten web sayfası. https, sorgu/fragman yok. Boşsa ticari dağıtım e-posta
# kullanamaz (yalnız push); bilgilendirme e-postası etkilenmez. Token CRYPTO_TOKEN_KEYS ile imzalanır.
CONSENT_UNSUBSCRIBE_BASE_URL=
# Bağlantının geçerlilik süresi (24h–9600h; varsayılan bir yıl).
CONSENT_UNSUBSCRIBE_TTL=8760h

# --- entitlements ---

# --- notify ---
# Dev: Mailpit (SMTP 1025, UI http://localhost:8025). staging/prod: a real relay, SMTP_TLS=starttls|tls,
# a real SMTP_FROM domain; the password comes from SMTP_PASSWORD_FILE (Docker secret).
# E-mail adapter (BE-113): smtp (the SMTP_* relay) | mem (kept in process memory, nothing is sent; dev only, refused
# in staging/prod). SMTP_FROM and SMTP_FROM_NAME are the sender of every adapter; the other SMTP_* only of smtp.
NOTIFY_EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS=none
SMTP_FROM=noreply@koro.test
SMTP_FROM_NAME=Koro
SMTP_TIMEOUT=15s
# SMTP_USERNAME=
# SMTP_PASSWORD=
# Bounce/complaint webhooks (POST /api/v1/webhooks/email/{ses|resend}); unset = that provider answers 401.
# Resend: the svix signing secret (EMAIL_WEBHOOK_RESEND_SECRET_FILE in staging/prod).
# EMAIL_WEBHOOK_RESEND_SECRET=whsec_...
# SES: the SNS topics allowed to post (comma separated). The topic must use SignatureVersion 2 (SHA256);
# confirm the HTTPS subscription in the AWS console (Koro never follows SubscribeURL).
# EMAIL_WEBHOOK_SES_TOPIC_ARNS=arn:aws:sns:eu-central-1:123456789012:koro-ses-events
# Push (BE-055). Unset = no-op adapter (the delivery is recorded, no device is reached); PUSH_REQUIRED=true refuses
# to start without a provider. FCM HTTP v1 (Android, web; iOS too when APNs is unset): the service account key file.
# Adapter (BE-113): auto (every provider whose PUSH_* settings are complete, none → no-op) | fcm | apns | fcm,apns
# (each listed provider must be configured) | noop (dev only, refused in staging/prod).
# NOTIFY_PUSH_PROVIDER=auto
# PUSH_REQUIRED=false
# PUSH_FCM_PROJECT_ID=koro-prod
# PUSH_FCM_CREDENTIALS_FILE=/run/secrets/fcm_service_account.json
# APNs, token based (.p8 key; iOS device tokens). PUSH_APNS_SANDBOX=true for development builds (not in prod).
# PUSH_APNS_KEY_FILE=/run/secrets/apns_key.p8
# PUSH_APNS_KEY_ID=ABC123DEFG
# PUSH_APNS_TEAM_ID=TEAM123456
# PUSH_APNS_TOPIC=app.koro.mobile
# PUSH_APNS_SANDBOX=false
# PUSH_TIMEOUT=10s

# --- identity ---
# E-posta bağlantılarının tek kökü (BE-096; api + worker): <APP_LINK_BASE_URL><sabit yol>#token=<token>. Yollar
# internal/platform/applink'te (/auth/verify-email, /auth/reset-password, /auth/confirm-email-change, /auth/verify-edu,
# /invitations/accept); bilet/bildirim sayfa bağlantıları da bu kökü kullanır. Token URL parçasındadır (sunucuya
# gitmez); bağlantıya GET hiçbir şeyi tüketmez, istemci token'ı ilgili /api/v1/... confirm ucuna POST eder.
# Mobil uygulama bu https kökün alan adında Universal/App Links ile açılır (/.well-known dosyaları bu alan adında
# sunulur; backend sunmaz). staging/prod: https, localhost değil; örn. https://app.example.invalid
APP_LINK_BASE_URL=http://localhost:3000
# Eski ad (BE-096 öncesi), hâlâ okunur; ikisi birden verilirse aynı olmalı. Yeni kurulumda kullanmayın.
# IDENTITY_LINK_BASE_URL=

# --- orgs ---

# --- directory ---

# --- students ---
# students.grant_suspension_window (BE-088, T-331/T-332): doğrulaması düşen öğrencinin askıdaki Seviye 3 izni bu süre
# boyunca açık kalır; öğrenci yeniden doğrulanınca bu süre içinde "devam ettir" diyebilir, süre dolunca gece işi
# (students.expire_suspended_grants) izni sistemce geri alır. 24h–8760h; varsayılan 90 gün.
STUDENTS_GRANT_SUSPENSION_WINDOW=2160h

# --- parties ---

# --- events ---

# --- talent ---
# talent.default_enabled (T-32): false iken talent defterine hiçbir satır yazılmaz, tüm sıralama bantları nötrdür.
# Hukuki dayanak kararı ve "aktivite temelli sıralama" aydınlatması yayımlanmadan true yapılmaz (ADR-0015).
TALENT_DEFAULT_ENABLED=false
# talent.auditor_api_enabled (03 §5.12, 04 §T): false iken /admin/talent/** uçları herkese 404 döner; true yalnız
# talent_auditor rolüne (en çok 2 kişi, MFA) açar. Her çağrı gerekçe başlığı ister ve audit'e yazılır.
TALENT_AUDITOR_API_ENABLED=false

# --- outreach ---
# Bir org'un 24 saatte yapabileceği kitle sayımı (countAudience, segment oluşturma/tanım güncelleme ve hedefli
# gönderinin Compile'ı birlikte; 1–10000). Dakikalık audience_count sınıfına ek: farksal saldırıya karşı bütçe.
OUTREACH_COUNT_DAILY_LIMIT=300
# Ticari e-postanın abonelikten çıkma bağlantısı consent'tedir: CONSENT_UNSUBSCRIBE_BASE_URL (BE-062).

# --- feed ---
# Yeni org'un kaç gönderisi moderatör onayından geçince ön onay kalkar (T-15: ilk 3 gönderi).
FEED_REVIEW_THRESHOLD=3
# Yayımlı gönderiyi moderatör kararına dek gizleyen açık şikâyetçi (farklı kullanıcı) sayısı (R-003 §1.5.3; 1–50).
FEED_REPORT_HIDE_THRESHOLD=3

# --- catalog ---

# --- discovery ---
# Şirket başına takma ad (anon_id) ve oturum sıralama tohumunun kendi anahtar halkası (BE-102, T-329):
# kimlik:base64[,kimlik:base64], anahtar ≥ 32 bayt, en çok 2 anahtar. İlki etkin (yeni yanıtlar), ikincisi yalnız
# eski takma adları çözer. CRYPTO_TOKEN_KEYS döndürülünce takma adlar değişmez. Etkin anahtar bir CRYPTO_TOKEN_KEYS
# anahtarı olamaz (süreç açılmaz). Aşağıdaki YALNIZ GELİŞTİRME yer tutucusudur; staging/prod'da zorunlu ve yer tutucu
# reddedilir. Prod: DISCOVERY_ANON_KEYS_FILE=/run/secrets/discovery_anon_keys. Üretmek: openssl rand -base64 32
# Boş bırakılırsa (yalnız dev) takma adlar eskisi gibi CRYPTO_TOKEN_KEYS'ten türetilir ve açılışta uyarı loglanır.
# Yenileme (yılda bir, akademik yıl başında; ayrıca anahtar sızınca hemen): yeni anahtar başa, eskisi ikinci sıraya
# 30 gün; şirketin sakladığı eski takma adlar bu pencerede açılır, sonra eski anahtar çıkarılır ve 404 olur. Açık
# arama sayfalarının imleçleri yenilemede geçersizleşir (arama baştan). Sızıntıda eski anahtar pencere beklemeden çıkar.
# Geçiş (BE-051 takma adları korunsun istenirse): CRYPTO_TOKEN_KEYS'in etkin anahtarı aynı kimlikle ikinci sıraya
# 30 gün eklenir, sonra çıkarılır.
DISCOVERY_ANON_KEYS=dev1:YW5vbmFub25hbm9uYW5vbmFub25hbm9uYW5vbmFub24=

# --- messaging ---

# --- orders ---
# Bir siparişin havaleyi bekleme süresi (T-13: 7 gün; 1h–720h). Süre dolunca orders.expire_unpaid siparişi
# kapatır, adetleri teklife iade eder ve bekleyen hakları iptal eder. İtiraz penceresi ve payout bekleme süresi
# ticaret politikasından gelir.
ORDERS_PAYMENT_WINDOW=168h

