# --- kvkk ---
# Veri sorumlusu irtibat kişisi posta kutusu: yeni başvurular ve 7 gün kala süre özeti
# (yalnız başvuru no/tür/son tarih). staging/prod'da zorunlu; boşsa dev'de yalnız uyarı loglanır.
KVKK_DPO_EMAIL=
# Dışa aktarma dosyasının saklama süresi (en çok 168h = 7 gün, T-83; ertelenmez).
KVKK_EXPORT_RETENTION=168h
