<p style="margin:0 0 12px 0;">Hello,</p>
<p style="margin:0 0 12px 0;">{{index .Data "org_name"}} invited you to Koro as {{template "role_en_html" .}}.</p>
<p style="margin:0 0 12px 0;"><a href="{{index .Data "link"}}" style="color:#1d4ed8;">Accept the invitation</a></p>
<p style="margin:0 0 12px 0;">Accept it with the Koro account that uses this e-mail address. The invitation is valid for {{index .Data "valid_days"}} days and can be used once. If the app asks for a code, enter: <code>{{index .Data "token"}}</code></p>
<p style="margin:0;">If you did not expect this invitation, ignore this message.</p>
{{define "role_en_html"}}{{$r := printf "%v" (index .Data "role")}}{{if eq $r "member"}}a member{{else if eq $r "club_admin"}}a club admin{{else if eq $r "university_rep"}}a university representative{{else if eq $r "career_staff"}}a career centre staff member{{else if eq $r "company_admin"}}a company admin{{else}}a recruiter{{end}}{{end}}
